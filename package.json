{
  "name": "monty",
  "version": "0.5.1",
  "description": "Keeps an eye on your coding agent: live Claude Code progress, readable specs, menu bar monocle.",
  "private": true,
  "type": "module",
  "bin": {
    "monty": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsc -p . && node dist/src/cli.js",
    "start": "node dist/src/cli.js",
    "scan": "tsc -p . && node dist/src/cli.js --scan",
    "test": "tsc -p . && node --test \"dist/test/*.test.js\"",
    "icons": "tsc -p . && node dist/src/cli.js --icon docs/icon-preview/monocle",
    "agent": "bash scripts/install-agent.sh",
    "smoke": "tsc -p . && node scripts/smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
